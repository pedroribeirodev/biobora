generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum PlanType {
  FREE
  PRO
}

enum LayoutType {
  CLASSIC
  MODERN
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  password      String?
  authProvider  AuthProvider  @default(EMAIL)
  planType      PlanType      @default(FREE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bios          Bio[]
  subscription  Subscription?

  @@map("users")
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  planType          PlanType
  stripeCustomerId  String?   @unique
  stripeSubscriptionId String? @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Bio {
  id              String      @id @default(cuid())
  userId          String
  slug            String      @unique
  title           String
  description     String?
  customDomain    String?     @unique
  layout          LayoutType  @default(CLASSIC)
  backgroundColor String      @default("#ffffff")
  textColor       String      @default("#000000")
  buttonColor     String      @default("#000000")
  buttonTextColor String      @default("#ffffff")
  fontFamily      String      @default("Inter")
  avatarUrl       String?
  showPoweredBy   Boolean     @default(true)
  isPublished     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  links         Link[]
  pageViews     PageView[]
  emailCaptures EmailCapture[]

  @@index([userId])
  @@index([slug])
  @@map("bios")
}

model Link {
  id          String    @id @default(cuid())
  bioId       String
  title       String
  url         String
  type        String    @default("link")
  icon        String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bio         Bio       @relation(fields: [bioId], references: [id], onDelete: Cascade)
  clicks      Click[]

  @@index([bioId])
  @@map("links")
}

model PageView {
  id          String    @id @default(cuid())
  bioId       String
  ipAddress   String?
  userAgent   String?
  referer     String?
  country     String?
  city        String?
  createdAt   DateTime  @default(now())

  bio Bio @relation(fields: [bioId], references: [id], onDelete: Cascade)

  @@index([bioId])
  @@index([createdAt])
  @@map("page_views")
}

model Click {
  id          String    @id @default(cuid())
  linkId      String
  ipAddress   String?
  userAgent   String?
  referer     String?
  country     String?
  city        String?
  createdAt   DateTime  @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([createdAt])
  @@map("clicks")
}

model EmailCapture {
  id        String   @id @default(cuid())
  bioId     String
  email     String
  name      String?
  message   String?
  createdAt DateTime @default(now())

  bio Bio @relation(fields: [bioId], references: [id], onDelete: Cascade)

  @@index([bioId])
  @@index([createdAt])
  @@map("email_captures")
}
